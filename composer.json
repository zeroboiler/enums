{
    "name": "zeroboiler/enums",
    "description": "Zero-boilerplate smart enum system with attribute-based metadata, auto-casting, validation and serialization for Laravel",
    "type": "library",
    "license": "proprietary",
    "version": "1.0.10",
    "keywords": ["laravel", "enum", "php-enum", "metadata", "attributes", "validation", "eloquent", "zeroboiler"],
    "homepage": "https://github.com/zeroboiler/enums",
    "support": {
        "issues": "https://github.com/zeroboiler/enums/issues",
        "source": "https://github.com/zeroboiler/enums"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.5",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/validation": "^13.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0",
        "laravel/pint": "^1.0",
        "rector/rector": "^2.0",
        "larastan/larastan": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "ZeroBoiler\\Enums\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ZeroBoiler\\Enums\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "analyse": "phpstan analyse",
        "lint": "pint",
        "rector": "rector",
        "ci": [
            "@lint",
            "@analyse",
            "@rector",
            "@test"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "ZeroBoiler\\Enums\\EnumsServiceProvider"
            ],
            "aliases": {
                "Enum": "ZeroBoiler\\Enums\\Facades\\Enum"
            }
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
